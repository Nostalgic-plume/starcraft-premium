DB_USERNAME=root
DB_PASSWORD=

# ── LLM 与向量化端点（对应 application.yml 的 rag.llm.*）──
# 主对话模型（DeepSeek 独立 Key，不受 DashScope 停用影响）
DEEPSEEK_API_KEY=
# 备用对话模型（主模型熔断时降级用）：建议与主模型不同厂商，保留异构容灾语义
# 默认指向智谱 glm-4-flash，故变量名为 BACKUP_LLM_*
BACKUP_LLM_API_KEY=
# 向量化端点：本地 TEI 部署的 BGE-M3（1024 维，由 docker-compose.yml 的 tei 服务提供）
# ⚠️ TEI 端口不可用 8080 —— 已被 server.port 占用，容器映射到 9090
# 未配置时走 application.yml 默认值 http://localhost:9090/v1
# ⚠️ 变量名必须与 application.yml 的 ${...} 占位符一致（EMBEDDING_*），
#    写成 TEI_* 不会生效 —— 后端会静默用默认值，看起来「配了但没变」
# EMBEDDING_BASE_URL=http://localhost:9090/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=dummy   # TEI 不校验鉴权，但 SDK 要求非空

# BGE-M3 权重目录（docker-compose.yml 的 tei 服务挂载到容器 /data/BAAI/bge-m3）
# ⚠️ 目录内必须含 1_Pooling/ 等完整权重，否则 TEI 会强制联网拉 1_Pooling/config.json 并卡死
# BGE_M3_MODEL_PATH=D:/models/bge-m3
# DashScope Key：embedding / backup 已不再引用，仅保留以便回滚旧配置
DASHSCOPE_API_KEY=

REDIS_PASSWORD=
DRUID_MONITOR_PASSWORD=
