{
  "mcpServers": {
    "qdrant": {
      "command": "uvx",
      "args": ["mcp-server-qdrant"],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "products",
        "EMBEDDING_MODEL": "BAAI/bge-m3",
        "QDRANT_READ_ONLY": "true",
        "QDRANT_SEARCH_LIMIT": "5"
      }
    }
  }
}
