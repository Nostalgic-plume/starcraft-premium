flowchart TB
    subgraph L1["接入层"]
        F["商城用户端 Vue 3<br/>首页榜单区块"]
        A["商城管理后台<br/>策略与坑位配置"]
    end

    subgraph L2["应用层 · 商城后端 Spring Boot 3.2.12"]
        B1["行为上报接口<br/>校验 + 投递 + 立即返回"]
        B2["榜单查询接口<br/>转发推荐服务 + 兜底"]
        B3["配置管理接口<br/>策略 / 坑位 / 过滤规则"]
    end

    subgraph L3["实时计算层"]
        K[("Kafka<br/>topic: user-behavior")]
        FL["Flink 1.17.2 作业<br/>事件时间 · 分钟分桶 · 即时更新"]
        JB["推荐服务定时任务<br/>画像生成 · 热度快照 · 指标统计"]
    end

    subgraph L4["推荐服务 · Spring Boot 独立进程"]
        RC["召回模块<br/>类目偏好召回 + 热门召回"]
        RK["融合过滤与重排模块<br/>去重 · 过滤 · 打分 · 固定坑位"]
        CS["榜单查询服务<br/>鉴权 · 结果缓存 · 降级"]
    end

    subgraph L5["存储层"]
        RD[("Redis 8.8<br/>实时特征 · 热度榜 · 结果缓存")]
        DB[("MySQL 8 推荐库<br/>画像 · 配置 · 坑位 · 指标")]
        PR[("商城业务库 · 只读<br/>product / sku / category / user")]
    end

    F -->|"上报行为事件"| B1
    F -->|"请求个性化榜单"| B2
    A -->|"配置策略与坑位"| B3
    B1 -->|"写入后立即返回"| K
    K --> FL
    FL -->|"写入实时特征"| RD
    K -->|"消费事件流"| JB
    JB --> DB
    JB --> RD
    B3 --> DB
    B2 --> CS
    CS --> RC
    RC -->|"读特征 / 热度 / 类目候选"| RD
    RC -->|"读商品可售状态"| PR
    RK --> RD
    RK -->|"读配置与坑位"| DB
    CS -->|"候选集与榜单"| B2
    B2 -->|"返回非空商品列表"| F
