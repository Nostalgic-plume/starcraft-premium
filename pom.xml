<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.shop</groupId>
    <artifactId>shop</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>shop</name>
    <description>B2C 电商后端系统（多模块：商城业务 / 推荐子系统 / 共享组件）</description>

    <!--
        模块划分：
          shop-common —— 共享组件（统一返回、业务异常、分页、登录态工具、缓存工具）
          shop-server —— 商城后端：商品/订单/交易 + RAG 客服，可执行产物为商城进程（8080）
          shop-rec    —— 推荐子系统：行为采集、实时特征、召回排序、策略配置，
                         既可作库被商城后端依赖（启用 M-01 行为上报入口），
                         也可独立启动为推荐服务进程（8082）

        依赖方向：shop-server → shop-rec → shop-common，无循环。
        另有独立工程 shop-rec-flink（Flink 作业，编译目标 Java 11，不参与本聚合构建）。
    -->
    <modules>
        <module>shop-common</module>
        <module>shop-server</module>
        <module>shop-rec</module>
    </modules>

    <properties>
        <!-- 本地开发JDK22；release 21 以启用虚拟线程 API（Executors.newVirtualThreadPerTaskExecutor），部署需 JDK 21+ -->
        <java.version>22</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lombok.version>1.18.38</lombok.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <hutool.version>5.8.35</hutool.version>
        <sa-token.version>1.45.0</sa-token.version>
        <springdoc.version>2.3.0</springdoc.version>
        <langchain4j.version>1.19.0</langchain4j.version>
        <!-- qdrant 集成模块在 1.x 仅发布 beta（0.36.2 为最后稳定版），版本与核心解耦 -->
        <langchain4j-qdrant.version>1.19.0-beta29</langchain4j-qdrant.version>
        <kafka.version>3.7.0</kafka.version>
        <druid.version>1.2.25</druid.version>
        <guava.version>33.2.1-jre</guava.version>
        <rocketmq-starter.version>2.2.3</rocketmq-starter.version>
        <rocketmq-client.version>4.9.7</rocketmq-client.version>
        <spring-dotenv.version>4.0.0</spring-dotenv.version>
        <!--
            Elasticsearch 客户端版本：必须与 compose 中的服务端镜像（shop-elasticsearch:8.11.4）严格一致。
            Spring Boot 3.2.12 的 BOM 默认管理为 8.10.x，8.x 客户端带 product check，
            minor 版本不一致会直接拒绝请求 —— 故此处覆盖 Boot 的同名 property（继承模式下生效），
            并在下方 dependencyManagement 显式锁两个坐标（客户端 + 底层 rest-client），防止传递依赖漂移。
            功能编号：001（docs/specs/001-es-keyword-search）
        -->
        <elasticsearch.version>8.11.4</elasticsearch.version>
    </properties>

    <!-- 版本统一在此管理，子模块引用时不写版本号 -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.shop</groupId>
                <artifactId>shop-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shop</groupId>
                <artifactId>shop-rec</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Druid 连接池 + SQL 监控/防火墙
                 注意：Spring Boot 3 必须用 druid-spring-boot-3-starter（jakarta.servlet），
                 不能用 druid-spring-boot-starter（Boot 2 的 javax.servlet 会启动失败） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Guava：布隆过滤器（防缓存穿透）。
                 hutool 内置 BitMapBloomFilter 按数值寻址，雪花大 ID 会数组越界，故改用 Guava 哈希版 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- Sa-Token -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- SpringDoc -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <optional>true</optional>
            </dependency>

            <!-- Kafka 客户端（推荐子系统行为事件流的生产端）
                 选型说明：使用原生 kafka-clients 而非 spring-kafka —— 后者会引入 KafkaAutoConfiguration，
                 与商城现网的 RocketMQ 并存时徒增自动配置干扰面；行为采集只需生产者，
                 原生客户端足够且可控（可精确设置 acks、幂等、投递超时）。 -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>

            <!-- LangChain4j -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-ollama</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-qdrant</artifactId>
                <!-- 1.19.0-beta29 依赖 langchain4j-core:1.19.0 + io.qdrant:client:1.17.0，与核心稳定版配套 -->
                <version>${langchain4j-qdrant.version}</version>
            </dependency>

            <!-- RocketMQ
                 版本说明：
                 1. rocketmq-spring-boot-starter 官方最新版仅到 2.3.0（无 3.x），Spring Boot 3 项目需手动注册
                    自动配置（见 shop-server/src/main/resources/META-INF/spring/...AutoConfiguration.imports）。
                 2. starter 2.2.3 的传递依赖会把 rocketmq-client 解析为 5.0.0，而 5.x 客户端与 4.9.x broker
                    的消费协议不兼容（消费者能注册心跳、Rebalance 正常，但拉取不到消息，消息在 broker 积压）。
                 3. 故排除 5.x 传递依赖，显式锁定 rocketmq-client 4.9.7，与 Docker broker（4.9.7）完全匹配。 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-starter.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.rocketmq</groupId>
                        <artifactId>rocketmq-client</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.rocketmq</groupId>
                        <artifactId>rocketmq-acl</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>${rocketmq-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-acl</artifactId>
                <version>${rocketmq-client.version}</version>
            </dependency>

            <!-- .env 文件自动加载 -->
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv</artifactId>
                <version>${spring-dotenv.version}</version>
            </dependency>

            <!-- Elasticsearch 官方 Java API Client（功能编号 001）
                 显式锁两个坐标：客户端本身 + 底层 rest-client。只锁前者时，
                 后者仍可能被 Boot BOM 解析成旧 minor 版本，运行期 product check 失败。 -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
