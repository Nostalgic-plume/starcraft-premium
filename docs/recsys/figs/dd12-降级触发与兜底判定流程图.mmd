flowchart TB
    A["榜单查询请求"] --> B["校验内部调用凭证"]
    B -- "不匹配" --> Y1["出口 A：上游兜底"]
    B --> C["解析用户身份"]
    C -- "无身份" --> Y2["出口 B：游客"]
    C --> D["读取特征与画像"]
    D -- "两者皆空" --> Y3["出口 C：冷启动"]
    D --> E["双路召回并行"]
    E -- "类目路异常" --> Y4["出口 D：召回降级"]
    E --> F["融合去重 + 过滤不可售"]
    F -- "候选为 0 / 状态不可确认" --> Y5["出口 E：兜底名单"]
    F --> G["加权打分 + 注入坑位"]
    G -- "特征缺失 / 打分异常" --> Y6["出口 F：特征缺失"]
    G --> H["生成快照并返回非空榜单"]
    H -- "快照异常" --> Y7["跳过缓存直接返回"]
    H -- "耗时超过 800ms" --> Y8["返回兜底名单"]
