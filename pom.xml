<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>com.shop</groupId>
    <artifactId>shop</artifactId>
    <version>1.0.0</version>
    <name>shop</name>
    <description>B2C 电商后端系统（单体架构）</description>

    <properties>
        <!-- 本地开发JDK22；release 21 以启用虚拟线程 API（Executors.newVirtualThreadPerTaskExecutor），部署需 JDK 21+ -->
        <java.version>22</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lombok.version>1.18.38</lombok.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <hutool.version>5.8.35</hutool.version>
        <sa-token.version>1.45.0</sa-token.version>
        <springdoc.version>2.3.0</springdoc.version>
        <langchain4j.version>1.19.0</langchain4j.version>
        <kafka.version>3.7.0</kafka.version>
    </properties>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Druid 连接池 + SQL 监控/防火墙
             注意：Spring Boot 3 必须用 druid-spring-boot-3-starter（jakarta.servlet），
             不能用 druid-spring-boot-starter（Boot 2 的 javax.servlet 会启动失败） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>1.2.25</version>
        </dependency>

        <!-- Hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- Guava：布隆过滤器（防缓存穿透）。
             hutool 内置 BitMapBloomFilter 按数值寻址，雪花大 ID 会数组越界，故改用 Guava 哈希版 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.2.1-jre</version>
        </dependency>

        <!-- Sa-Token -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- SpringDoc -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!--
            Kafka 客户端（推荐子系统行为事件流的生产端）
            选型说明：使用原生 kafka-clients 而非 spring-kafka —— 后者会引入 KafkaAutoConfiguration，
            与商城现网的 RocketMQ 并存时徒增自动配置干扰面；行为采集只需生产者，原生客户端足够且可控
            （可精确设置 acks、幂等、投递超时）。消费端在独立 Flink 作业中，不依赖本模块。
        -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>

        <!-- LangChain4j -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-qdrant</artifactId>
            <!-- 注意：qdrant 集成模块在 1.x 仅发布 beta（0.36.2 为最后稳定版）。
                 1.19.0-beta29 依赖 langchain4j-core:1.19.0 + io.qdrant:client:1.17.0，与核心稳定版配套 -->
            <version>1.19.0-beta29</version>
        </dependency>

        <!-- RocketMQ -->
        <!--
            版本说明：
            1. rocketmq-spring-boot-starter 官方最新版仅到 2.3.0（无 3.x），Spring Boot 3 项目需手动注册
               自动配置（见 src/main/resources/META-INF/spring/...AutoConfiguration.imports）。
            2. starter 2.2.3 的传递依赖会把 rocketmq-client 解析为 5.0.0，而 5.x 客户端与 4.9.x broker
               的消费协议不兼容（消费者能注册心跳、Rebalance 正常，但拉取不到消息，消息在 broker 积压）。
            3. 故排除 5.x 传递依赖，显式锁定 rocketmq-client 4.9.7，与 Docker broker（4.9.7）完全匹配。
        -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.2.3</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.rocketmq</groupId>
                    <artifactId>rocketmq-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.rocketmq</groupId>
                    <artifactId>rocketmq-acl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
            <version>4.9.7</version>
        </dependency>
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-acl</artifactId>
            <version>4.9.7</version>
        </dependency>

        <!-- .env 文件自动加载 -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.12</version>
                <configuration>
                    <!--
                        spring-boot:run 的默认主类。工程内含两个启动类
                        （商城后端 ShopApplication / 推荐服务 RecApplication），插件无法自动推断，
                        不显式指定时 run 会报 "Unable to find a single main class from the following
                        candidates [com.shop.ShopApplication, com.shop.rec.RecApplication]"。
                        默认指向商城后端；临时跑推荐服务用：
                        mvn spring-boot:run -Dspring-boot.run.main-class=com.shop.rec.RecApplication
                        注意：下面两个 repackage execution 各自声明了 mainClass（execution 级优先），
                        打包产物 shop-1.0.0.jar / shop-1.0.0-rec.jar 的入口不受此处影响。
                    -->
                    <mainClass>com.shop.ShopApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <!--
                    双进程打包说明：
                    同一工程内含两个启动类（商城后端 ShopApplication 与推荐服务 RecApplication），
                    故显式绑定各自的可执行 jar 产物：
                    - 默认 execution 产出的 shop-1.0.0.jar 仍为商城后端，沿用原有部署方式不变；
                    - repackage-rec execution 产出 shop-1.0.0-rec.jar，为推荐服务（端口 8082）启动包。
                -->
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.shop.ShopApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>repackage-rec</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.shop.rec.RecApplication</mainClass>
                            <classifier>rec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>